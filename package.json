{
  "name": "solana-agentic-tx-reviewer",
  "version": "0.1.0",
  "private": true,
  "description": "Lightweight AI-assisted Solana transaction review tool (read-only PoC).",
  "workspaces": ["packages/*"],
  "scripts": {
    "dev": "npm run build:core && next dev",
    "build": "npm run build:core && next build",
    "build:core": "tsc -p packages/core/tsconfig.json",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "npm run build:core && tsc --noEmit",
    "test": "npm run build:core && tsx tests/heuristics.test.ts && tsx tests/lib.test.ts"
  },
  "dependencies": {
    "@solana-tx-reviewer/core": "*",
    "@solana/web3.js": "^1.98.4",
    "next": "^16.2.7",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.0",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.16",
    "@types/react-dom": "^19.2.3",
    "postcss": "^8.5.15",
    "tailwindcss": "^4.3.0",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  }
}
