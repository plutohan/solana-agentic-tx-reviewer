# ---------------------------------------------------------------------------
# Solana Agentic Transaction Reviewer — environment configuration
# Copy to .env.local and fill in. All values are optional for the PoC.
# ---------------------------------------------------------------------------

# Default mainnet RPC endpoint used by the server. The public endpoint
# (https://api.mainnet-beta.solana.com) rate-limits heavily and prunes old
# transactions — use a Helius / QuickNode / Triton URL for reliable results.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# ---------------------------------------------------------------------------
# Optional: connect a real LLM for the explanation layer.
# Leave AI_PROVIDER unset to use the deterministic placeholder (default).
# ---------------------------------------------------------------------------
# AI_PROVIDER=anthropic          # or "openai"
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
