# ---------------------------------------------------------------------------
# Solana Agentic Transaction Reviewer - environment configuration
# Local: copy to .env.local. Production: set these in your host (e.g. Vercel).
# Everything has a safe default, so the app runs with no config at all.
# ---------------------------------------------------------------------------

# Server-side RPC endpoint. The public endpoint (api.mainnet-beta.solana.com)
# rate-limits heavily, prunes old transactions, and OFTEN REJECTS the pre-sign
# simulation (simulate-with-accounts). Use a Helius / QuickNode / Triton URL for
# reliable results, and REQUIRED for the pre-sign feature to work in production.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Public base URL of the deployment. Used for OpenGraph image/permalink URLs.
# On Vercel this auto-detects from VERCEL_URL, so you can leave it unset, or set
# it to your custom domain.
# NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app

# ---------------------------------------------------------------------------
# Optional: connect a real LLM for the explanation layer.
# Leave AI_PROVIDER unset to use the free deterministic placeholder (default).
# Any LLM error falls back to the placeholder, so the app always works.
# ---------------------------------------------------------------------------
# AI_PROVIDER=anthropic          # or "openai"
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001   # optional override
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini                     # optional override
