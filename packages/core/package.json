{
  "name": "@solana-tx-reviewer/core",
  "version": "0.1.0",
  "description": "Zero-dependency, deterministic Solana transaction risk engine: assessRisk, the program registry, an instruction-discriminator decoder, and the shared types. No network, no signing. Runs in Node, the browser, CI, and agent runtimes.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist", "README.md"],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "solana",
    "transaction",
    "risk",
    "security",
    "heuristics",
    "agent",
    "deterministic",
    "pre-sign"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/plutohan/solana-agentic-tx-reviewer"
  },
  "homepage": "https://solana-agentic-tx-reviewer.vercel.app"
}
